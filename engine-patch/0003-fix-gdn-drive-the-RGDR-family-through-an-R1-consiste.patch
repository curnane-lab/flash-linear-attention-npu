@@ -413,6 +413,14 @@ class AscendGatedDeltaNetAttention(GatedDeltaNetAttention):
         self_kv_cache = self.kv_cache
         ssm_state = self_kv_cache[1]
         num_actual_tokens = attn_metadata.num_actual_tokens
+        # While the recover flag is on, the R1 OPP shadows the wheel's RGDR
