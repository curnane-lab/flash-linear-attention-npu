+                num_accepted_tokens=None,
             ).unsqueeze(0)
         else:
             core_attn_out_decode = None
@@ -738,7 +747,7 @@ class AscendGatedDeltaNetAttention(GatedDeltaNetAttention):
             actual_seq_lengths = attn_metadata.non_spec_decode_metadata.actual_seq_lengths
             query_non_spec = l2norm_fwd(query_non_spec)
             key_non_spec = l2norm_fwd(key_non_spec)
-            core_attn_out_non_spec = recurrent_gated_delta_rule(
+            core_attn_out_non_spec = rgdr_op(
                 query_non_spec.squeeze(0),
                 key_non_spec.squeeze(0),
                 value_non_spec.squeeze(0),
@@ -748,6 +757,7 @@ class AscendGatedDeltaNetAttention(GatedDeltaNetAttention):
                 scale=key_non_spec.shape[-1] ** -0.5,
                 actual_seq_lengths=actual_seq_lengths,
