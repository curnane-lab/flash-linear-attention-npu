+        )
 
         mixed_qkv = mixed_qkv[:num_actual_tokens]
         b = b[:num_actual_tokens]
@@ -592,7 +600,7 @@ class AscendGatedDeltaNetAttention(GatedDeltaNetAttention):
                     max_window=self.num_spec + 1,
                 ).unsqueeze(0)
             else:
-                core_attn_out_spec = recurrent_gated_delta_rule(
+                core_attn_out_spec = rgdr_op(
                     query_spec.squeeze(0),
                     key_spec.squeeze(0),
                     value_spec.squeeze(0),
@@ -617,7 +625,7 @@ class AscendGatedDeltaNetAttention(GatedDeltaNetAttention):
             actual_seq_lengths = attn_metadata.non_spec_decode_metadata.actual_seq_lengths
             query_decode = l2norm_fwd(query_decode)
             key_decode = l2norm_fwd(key_decode)
-            core_attn_out_decode = recurrent_gated_delta_rule(
+            core_attn_out_decode = rgdr_op(
                 query_decode.squeeze(0),
