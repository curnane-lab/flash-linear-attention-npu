     return bool((pool[-1] == RECORD_SENTINEL).all())
 
 
+# Startup capability probe ---------------------------------------------------
+#
+# Symbol resolution alone is NOT sufficient: with the wheel OPP ahead of the
+# R1 OPP in ASCEND_CUSTOM_OPP_PATH the recover entry has been observed to
+# launch successfully while writing wrong records (N10 probe history).  The
+# probe below runs a fixed small case through the private runtime before any
+# graph capture and checks the effective records cells against an fp64 CPU
+# reference, the untouched-row sentinels, and bitwise out/state parity with
+# the stock entry of the same runtime.  Any mismatch refuses startup.
+
+_PROBE_PASSED = False
+
+_TOL_PROBE_OUT = 5e-3
+_TOL_PROBE_STATE = 1e-3
+_TOL_PROBE_DC = 1e-3
+_TOL_PROBE_ALPHA = 1e-5
+
+_OPP_HINT = ("the recover entry is known to launch but write wrong records "
+             "when the wheel OPP precedes the R1 (recover-capable) OPP in "
+             "ASCEND_CUSTOM_OPP_PATH; put the R1 OPP first")
+
+
+def _rel(a: torch.Tensor, b: torch.Tensor) -> float:
+    return float((a.double() - b.double()).norm()
+                 / b.double().norm().clamp_min(1e-12))
+
+
+def _probe_reference(q, k, v, g, beta, state0, indices, record_indices,
+                     lengths, scale, accepted):
+    """fp64 CPU reference for the probe case (delta-rule recurrence)."""
+    T = q.shape[0]
+    H, HV = q.shape[1], v.shape[1]
+    V = v.shape[-1]
+    kidx = [hv // (HV // H) for hv in range(HV)]
+    out = torch.zeros(T, HV, V, dtype=torch.float64)
+    dest = state0.clone()
+    records: dict[int, dict[int, tuple]] = {}
+    off = 0
+    for b, L in enumerate(lengths):
+        M = state0[int(indices[off + accepted[b] - 1])].clone()
+        for i in range(L):
+            t = off + i
+            a = g[t].exp().view(HV, 1)
+            kk = k[t][kidx]
+            dc = beta[t].view(HV, 1) * (v[t] - a * torch.einsum(
+                "hvk,hk->hv", M, kk))
+            M = a.view(HV, 1, 1) * M + torch.einsum("hv,hk->hvk", dc, kk)
+            out[t] = torch.einsum("hvk,hk->hv", M, q[t][kidx]) * scale
+            dest[int(indices[t])] = M
+            records.setdefault(int(record_indices[t]), {})[i] = (
+                dc, kk, a.view(HV))
+        off += L
+    return out, dest, records
+
+
+def assert_recover_capability(device) -> None:
+    """Prove the recover entry computes correct records, or refuse startup."""
+    global _PROBE_PASSED
+    if _PROBE_PASSED:
+        return
+    gen = torch.Generator().manual_seed(20261022)
+    H, HV, K, V = 2, 4, 128, 128
+    lengths = [4, 2, 4]
+    T = sum(lengths)
+    scale = K ** -0.5
+    q = torch.randn(T, H, K, generator=gen)
+    k = torch.randn(T, H, K, generator=gen)
+    q = q / q.norm(dim=-1, keepdim=True)
+    k = k / k.norm(dim=-1, keepdim=True)
+    v = torch.randn(T, HV, V, generator=gen)
+    g = -torch.rand(T, HV, generator=gen) * 0.5
+    beta = torch.rand(T, HV, generator=gen)
+    indices = [1, 1, 1, 1, 2, 2, 3, 3, 3, 3]
+    record_indices = [2, 2, 2, 2, 0, 0, 5, 5, 5, 5]
+    accepted = [3, 2, 1]
+    # Non-contiguous, request-shared record rows on purpose: the probe must
+    # exercise the record-row namespace, not just range(T).
+    untouched_rows = [0, 4, 5, 6, 7]
+    state0 = torch.randn(8, HV, V, K, generator=gen) * 0.2
+    state0[untouched_rows] = RECORD_SENTINEL
+
+    q_d, k_d = q.to(torch.bfloat16).to(device), k.to(torch.bfloat16).to(device)
+    v_d = v.to(torch.bfloat16).to(device)
+    g_d = g.float().to(device)
+    beta_d = beta.to(torch.bfloat16).to(device)
+
+    ref_out, ref_dest, ref_records = _probe_reference(
+        q_d.cpu().double(), k_d.cpu().double(), v_d.cpu().double(),
+        g_d.cpu().double(), beta_d.cpu().double(), state0.double(),
+        indices, record_indices, lengths, scale, accepted)
+
+    csl = torch.tensor([0] + lengths, dtype=torch.int32, device=device)
+    idx = torch.tensor(indices, dtype=torch.int32, device=device)
+    ridx = torch.tensor(record_indices, dtype=torch.int32, device=device)
+    acc = torch.tensor(accepted, dtype=torch.int32, device=device)
+    records_rows = max(record_indices) + 2
+    records = torch.full((records_rows, HV, MAX_MTP_WINDOW, V + K + 1),
+                         RECORD_SENTINEL, dtype=torch.float32, device=device)
+
+    def fail(detail):
+        raise RuntimeError(
+            f"gdn recover capability probe failed: {detail}; {_OPP_HINT}")
+
+    state = state0.float().to(device).contiguous()
+    out = recurrent_gated_delta_rule_recover_verify(
+        q_d, k_d, v_d, state, g=g_d, beta=beta_d, scale=scale,
+        actual_seq_lengths=csl, ssm_state_indices=idx, num_accepted_tokens=acc,
+        record_indices=ridx, records=records, max_window=max(lengths))
+    torch.npu.synchronize()
+
+    if _rel(out.cpu(), ref_out) >= _TOL_PROBE_OUT:
+        fail(f"out rel { _rel(out.cpu(), ref_out):.3e } >= {_TOL_PROBE_OUT}")
+    for row in (1, 2, 3):
+        r = _rel(state.cpu()[row], ref_dest[row])
+        if r >= _TOL_PROBE_STATE:
+            fail(f"dest row {row} rel {r:.3e} >= {_TOL_PROBE_STATE}")
+    if not bool((state.cpu()[untouched_rows] == RECORD_SENTINEL).all()):
+        fail("untouched state pool rows were modified")
+
+    rec = records.cpu()
+    for row, steps in ref_records.items():
+        for i, (dc, kk, a) in steps.items():
+            if not bool((rec[row, :, i, V:V + K] == kk.float()).all()):
+                fail(f"records row {row} step {i} key field not bit-exact")
+            if _rel(rec[row, :, i, :V], dc) >= _TOL_PROBE_DC:
+                fail(f"records row {row} step {i} dc mismatch")
+            if _rel(rec[row, :, i, V + K], a.view(HV)) >= _TOL_PROBE_ALPHA:
+                fail(f"records row {row} step {i} alpha mismatch")
+    written_rows = set(ref_records)
+    for row in range(records_rows):
+        if row not in written_rows and not bool(
+                (rec[row] == RECORD_SENTINEL).all()):
+            fail(f"records row {row} (unwritten) was modified")
+    for row, steps in ref_records.items():
+        for j in range(MAX_MTP_WINDOW):
+            if j not in steps and not bool(
+                    (rec[row, :, j, :] == RECORD_SENTINEL).all()):
+                fail(f"records row {row} step {j} (unwritten) was modified")
+
+    state_b = state0.float().to(device).contiguous()
+    out_b = recurrent_gated_delta_rule_stock(
+        q_d, k_d, v_d, state_b, g=g_d, beta=beta_d, scale=scale,
+        actual_seq_lengths=csl, ssm_state_indices=idx,
+        num_accepted_tokens=acc)
+    torch.npu.synchronize()
+    if not bool((out == out_b).all()):
+        fail("recover out is not bitwise equal to the stock entry")
+    if not bool((state == state_b).all()):
+        fail("recover state is not bitwise equal to the stock entry")
+    _PROBE_PASSED = True
+
+
 def workspace_report() -> dict:
     """Post-run verification: sentinel rows intact, fallback counts, bytes."""
     return {
@@ -299,4 +554,6 @@ def workspace_report() -> dict:
         "window": _RECORD_WINDOW,
         "fallbacks": dict(FALLBACKS),
         "calls": dict(CALLS),
+        "calls_by_phase": {k: dict(v) for k, v in CALLS_PHASE.items()},
+        "capability_probe_passed": _PROBE_PASSED,
     }
