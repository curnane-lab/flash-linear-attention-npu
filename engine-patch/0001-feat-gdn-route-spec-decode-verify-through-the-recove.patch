--- /dev/null
+++ b/vllm_ascend/ops/gdn_recover.py
@@ -0,0 +1,195 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Ascend project
+"""Experimental GDN recover-operator wiring for the spec-decode verify path.
+
+Behind ``VLLM_ASCEND_GDN_RECOVER=1`` the pure-spec verify call in
+``vllm_ascend/ops/gdn.py`` is routed to the recover operator
+(``aclnnRecurrentGatedDeltaRuleRecover``) instead of the stock
+``recurrent_gated_delta_rule``.  The call goes through the installed
+``fla_npu.ops.ascendc._runtime`` ctypes two-stage aclnn machinery; the recover
+kernel binaries come from the operator's OPP build via
+``ASCEND_CUSTOM_OPP_PATH``.  No Stable-ABI launcher is loaded, so the stock
+``fla_npu`` backends (and their ``torch.ops.fla_npu_stable`` namespace) are
+untouched.
+
+Contract notes (gdn recover operator, R1-fixed):
+  * ``source_state`` is left null: the call keeps the stock in-place read
+    semantics, which the recover entry reproduces bit-for-bit, so the
+    read-row-in-write-window aliasing of the engine's slot reuse does not
+    apply (the R1-3 source/destination overlap rule only governs a provided
+    ``source_state``).
+  * ``records`` is a per-layer fp32 workspace ``[capacity, HV, 8, V+K+1]``
+    (dim 2 frozen at MAX_MTP=8); ``record_indices`` is an int32 per-token row
+    index (request ordinal within the verify call).  Records are written for
+    contract/verification only; the engine does not consume them.
+  * ``num_accepted_tokens`` is clamped into [1, num_spec+1] before launch:
+    0/-1/>L are silent no-ops in the operator.
+"""
+
+import ctypes
+
+import torch
+
+import vllm_ascend.envs as envs
+
+ENTRY_NAME = "aclnnRecurrentGatedDeltaRuleRecover"
+MAX_MTP_WINDOW = 8
+RECORD_SENTINEL = -777.0
+
+
+def recover_enabled() -> bool:
+    return bool(envs.VLLM_ASCEND_GDN_RECOVER)
+
+
+def recover_available() -> bool:
+    """Whether the recover aclnn entry resolves against the loaded opapi."""
+    if not recover_enabled():
+        return False
+    try:
+        from fla_npu.ops.ascendc._runtime import runtime
+
+        runtime().symbol(ENTRY_NAME + "GetWorkspaceSize")
+        return True
+    except Exception:
+        return False
+
+
+# Allocated by the GDN attention metadata builder (one builder covers the GDN
+# layer group) before any graph capture, and consumed read-only at the verify
+# call site.  Module-level because the attention metadata object is shared
+# across the layers of the group while the records workspaces are per layer.
+_RECORDS_POOLS: dict[str, torch.Tensor] = {}
+_RECORD_INDEX_BUFFER: torch.Tensor | None = None
+_RECORD_WINDOW: int = 0
+# Steps that stayed on the stock operator although the flag was on, by reason.
+FALLBACKS: dict[str, int] = {"no_pool": 0, "nonuniform_window": 0,
+                             "mixed_batch": 0}
+
+
+def configure_workspace(
+    *,
+    layer_names: list[str],
+    request_capacity: int,
+    window: int,
+    ssm_state_shape: tuple[int, ...],
+    device: torch.device,
+) -> None:
+    """Allocate the records workspaces and the per-token row-index buffer.
+
+    ``ssm_state_shape`` is the per-block temporal state shape (HV, V, K).
+    Each pool holds ``request_capacity`` usable rows plus one sentinel tail
+    row kept at RECORD_SENTINEL so a post-run check proves the operator never
+    wrote outside the leased rows.
+    """
+    global _RECORD_INDEX_BUFFER, _RECORD_WINDOW
+    num_v_heads, head_v_dim, head_k_dim = ssm_state_shape
+    for name in layer_names:
+        if name in _RECORDS_POOLS:
+            continue
+        pool = torch.full(
+            (request_capacity + 1, num_v_heads, MAX_MTP_WINDOW,
+             head_v_dim + head_k_dim + 1),
+            RECORD_SENTINEL,
+            dtype=torch.float32,
+            device=device,
+        )
+        pool[:request_capacity] = float("nan")
+        _RECORDS_POOLS[name] = pool
+    _RECORD_INDEX_BUFFER = (
+        torch.arange(
+            request_capacity * window, dtype=torch.int32, device=device
+        )
+        // window
+    )
+    _RECORD_WINDOW = window
+
+
+def get_records_pool(layer_name: str) -> torch.Tensor | None:
+    return _RECORDS_POOLS.get(layer_name)
+
+
+def record_indices_for(num_tokens: int, num_requests: int) -> torch.Tensor | None:
+    """Per-token records row (request ordinal) for a pure spec-decode batch.
+
+    Fast path: the window is uniform, so the precomputed buffer view is exact.
+    Non-uniform batches (a truncated final request) fall back to None and the
+    caller uses the stock operator for that step.
+    """
+    if (
+        _RECORD_INDEX_BUFFER is None
+        or num_tokens != num_requests * _RECORD_WINDOW
+        or num_tokens > _RECORD_INDEX_BUFFER.numel()
+    ):
+        FALLBACKS["nonuniform_window"] += 1
+        return None
+    return _RECORD_INDEX_BUFFER[:num_tokens]
+
+
+def records_sentinel_ok(pool: torch.Tensor) -> bool:
+    return bool((pool[-1] == RECORD_SENTINEL).all())
+
+
+def workspace_report() -> dict:
+    """Post-run verification: sentinel rows intact, fallback counts, bytes."""
+    return {
+        "pools": {
+            name: {
+                "shape": list(pool.shape),
+                "sentinel_ok": records_sentinel_ok(pool),
+            }
+            for name, pool in _RECORDS_POOLS.items()
+        },
+        "pool_bytes_total": sum(p.numel() * p.element_size()
+                                for p in _RECORDS_POOLS.values()),
+        "window": _RECORD_WINDOW,
+        "fallbacks": dict(FALLBACKS),
+    }
+
+
+def recurrent_gated_delta_rule_recover_verify(
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    ssm_state: torch.Tensor,
+    *,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    scale: float,
+    actual_seq_lengths: torch.Tensor,
+    ssm_state_indices: torch.Tensor,
+    num_accepted_tokens: torch.Tensor,
+    record_indices: torch.Tensor,
+    records: torch.Tensor,
+    max_window: int,
+) -> torch.Tensor:
+    """Recover-entry verify call; same out/state semantics as the stock op.
+
+    ``num_accepted_tokens`` is clamped to [1, max_window] (the operator treats
+    0/-1/>L as silent no-ops).  Returns the per-token output tensor.
+    """
+    from fla_npu.ops.ascendc._runtime import call_aclnn
+
+    num_accepted = num_accepted_tokens.to(torch.int32).clamp(1, max_window)
+    out = torch.empty_like(value)
+
+    def build(ctx):
+        return [
+            ctx.tensor(query, "query"),
+            ctx.tensor(key, "key"),
+            ctx.tensor(value, "value"),
+            ctx.tensor(beta, "beta"),
+            ctx.tensor(None, "source_state"),
+            ctx.tensor(ssm_state, "state"),
+            ctx.tensor(actual_seq_lengths, "actual_seq_lengths"),
+            ctx.tensor(ssm_state_indices, "ssm_state_indices"),
+            ctx.tensor(record_indices, "record_indices"),
+            ctx.tensor(g, "g"),
+            ctx.tensor(None, "gk"),
+            ctx.tensor(num_accepted, "num_accepted_tokens"),
+            ctypes.c_float(scale),
+            ctx.tensor(out, "out"),
+            ctx.tensor(records, "records"),
+        ]
+
+    call_aclnn(ENTRY_NAME, build, (out,))
+    return out
-- 
